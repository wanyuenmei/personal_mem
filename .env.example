# ============================================================================
# LOCAL defaults are the values shown here. To DEPLOY, flip the
# marked vars — nothing else needs to change.
# ============================================================================

# --- Extraction mode: anthropic | ollama | none ---
# anthropic: Claude extracts/dedups facts on write (needs ANTHROPIC_API_KEY)
# ollama:    local LLM extracts facts (nothing leaves the machine)
# none:      no LLM — store raw text + local embeddings (nothing leaves the machine)
EXTRACTION_MODE=anthropic
# Recommended: keep ANTHROPIC_API_KEY in ~/.env (global, chmod 600) instead of
# here — config.py loads ~/.env as a fallback. Setting it here also works and wins.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_MODEL=llama3.1:8b

# --- Embedder (local + free in all modes) ---
# fastembed (default, ONNX — used LOCAL and prod for parity) | huggingface
EMBEDDER_PROVIDER=fastembed
EMBEDDER_MODEL=              # blank = provider default (both known defaults are 384-dim)
EMBED_DIMS=                  # blank = derived from the model; set only to override

# --- Vector store ---
# chroma (default, local) | pgvector (deploy)
VECTOR_STORE=chroma
DATABASE_URL=               # set by Railway when VECTOR_STORE=pgvector
PG_COLLECTION=context_layer

# --- MCP transport ---
# stdio (default, Claude Desktop) | streamable-http (deploy)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
# PORT is injected by Railway; MCP_PORT is the local fallback
MCP_PORT=8000

# --- HTTP guardrails (stopgap until OAuth) ---
# If set, the MCP endpoint is served at /<token>/mcp — the URL is the credential
# (capability URL). Connector UIs can't send headers and strip query params, and
# a 401 would trigger a doomed OAuth flow, so the secret lives in the path and
# wrong paths just 404. LEAVE SET on any public deploy; unset = /mcp (local).
CONTEXT_LAYER_TOKEN=
# Crude global cap (requests/min) so an exposed endpoint can't run up Anthropic spend.
RATE_LIMIT_RPM=120

# --- OAuth multi-tenancy (WorkOS AuthKit) — OPT-IN, additive ---
# When ALL of WORKOS_CLIENT_ID + WORKOS_AUTHKIT_DOMAIN + PUBLIC_SERVER_URL are
# set, the HTTP transport runs as an OAuth 2.0 Resource Server: connectors
# discover /.well-known/oauth-protected-resource, register + sign in AGAINST
# WORKOS, and each /mcp request must carry a WorkOS-issued Bearer token we verify
# against WorkOS's public JWKS. resolve_user_id then namespaces each signed-in
# user into their own store. When UNSET, nothing changes: the capability-path
# stopgap above stays in force. Do NOT retire CONTEXT_LAYER_TOKEN yet (PER-22).
#
# Never commit real values here — set them as deploy secrets.
WORKOS_CLIENT_ID=            # WorkOS Dashboard -> API Keys ("Client ID", client_...)
WORKOS_API_KEY=             # optional (JWKS is public); WorkOS secret key sk_...
WORKOS_AUTHKIT_DOMAIN=      # AuthKit issuer URL, e.g. https://your-app.authkit.app
PUBLIC_SERVER_URL=          # this server's public MCP URL, e.g. https://your-domain/mcp
WORKOS_API_BASE_URL=https://api.workos.com   # override only for non-prod WorkOS envs
WORKOS_AUDIENCE=            # optional; validate token `aud` if your tenant sets it
WORKOS_REQUIRED_SCOPES=     # optional, space/comma-separated; empty = any valid token
WORKOS_USER_ID_PREFIX=workos_  # prefix for per-tenant mem0 user_id (isolation)
WORKOS_LEEWAY=60            # clock-skew tolerance (s) for token exp/iat; 0 disables

# --- Paths / identity ---
CONTEXT_LAYER_DATA=~/.context-layer
USER_ID=mei

# ----------------------------------------------------------------------------
# DEPLOY OVERRIDES (set these on Railway):
#   VECTOR_STORE=pgvector
#   DATABASE_URL=<from Railway Postgres>
#   MCP_TRANSPORT=streamable-http
#   ANTHROPIC_API_KEY=<secret>
#   CONTEXT_LAYER_TOKEN=<a long random secret>   # protects the public endpoint
# ----------------------------------------------------------------------------
